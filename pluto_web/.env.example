# ─── Supabase (REQUIRED) ─────────────────────────────
# Get these from: https://supabase.com/dashboard → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
RAZORPAY_KEY_ID=

# ─── Backend API (REQUIRED for payments & notifications) ──
# In dev: leave empty (Vite proxy handles it via vite.config.ts)
# In production: set to your backend URL (e.g. https://pluto.render.com)
VITE_API_BASE=
